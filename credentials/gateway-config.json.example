{
  "_readme": "Easy-auth gateway gate credential for Google Docs/Sheets. Copy this file to gateway-config.json and fill in real values. gateway-config.json is gitignored (credentials/* in .gitignore) — never commit it.",
  "_where_values_come_from": "The gateway operator mints clientId + clientSecret via scripts/gen-gate-secret.mjs and gives you the base_url after deploy. The gateway holds the Google client_secret server-side — your skill never sees it.",
  "base_url": "https://us-central1-<PROJECT_ID>.cloudfunctions.net/gateway",
  "client_id": "<your-gate-clientId>",
  "client_secret": "<your-gate-clientSecret>"
}
